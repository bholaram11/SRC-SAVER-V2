{
  "name": "SRC Bot v3 - Personal Use",
  "description": "Optimized Telegram content bot for personal use",
  "keywords": ["python3", "telegram", "telegram-bot", "pyrogram"],
  "env": {
    "API_ID": {
      "description": "Telegram API ID from https://my.telegram.org",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API Hash from https://my.telegram.org",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Bot token from @BotFather",
      "required": true
    },
    "MONGO_DB": {
      "description": "MongoDB connection URL from https://cloud.mongodb.com",
      "required": true
    },
    "OWNER_ID": {
      "description": "Your Telegram user ID",
      "required": true
    },
    "LOG_GROUP": {
      "description": "Log channel/group ID (-100xxx), bot must be admin",
      "required": true
    },
    "CHANNEL_ID": {
      "description": "Force-sub channel ID (-100xxx), bot must be admin",
      "required": true
    },
    "STRING": {
      "description": "Pyrogram session string for 4GB upload support",
      "value": "",
      "required": false
    },
    "DEFAULT_SESSION": {
      "description": "Default userbot session string (skip /login)",
      "value": "",
      "required": false
    },
    "BATCH_LIMIT": {
      "description": "Max batch range (default: 500)",
      "value": "500",
      "required": false
    },
    "MAX_PARALLEL_UPLOADS": {
      "description": "Concurrent upload slots (default: 2)",
      "value": "2",
      "required": false
    },
    "MAX_PENDING_FILES": {
      "description": "Pause downloads at this many pending files (default: 7)",
      "value": "7",
      "required": false
    },
    "MAX_PENDING_SIZE_GB": {
      "description": "Pause downloads at this total pending size in GB (default: 2)",
      "value": "2",
      "required": false
    }
  },
  "buildpacks": [
    { "url": "heroku/python" }
  ],
  "stack": "container"
}
